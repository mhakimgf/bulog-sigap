// Skema Database PostgreSQL untuk SIGAP BULOG
// Sistem Inventaris Pergudangan & Stock Opname Terpadu

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. MANAJEMEN PENGGUNA & RBAC (Role-Based Access Control)
// -------------------------------------------------------------
enum UserRole {
  superadmin
  kepala_gudang
  operator
}

enum AccountStatus {
  aktif
  nonaktif
}

model User {
  id         String        @id @default(cuid())
  name       String        @db.VarChar(150)
  email      String        @unique @db.VarChar(100)
  nip        String        @unique @db.VarChar(50)
  password   String        @db.VarChar(255)
  role       UserRole      @default(operator)
  unitGudang String        @default("GBB CISKID") @db.VarChar(100)
  status     AccountStatus @default(aktif)
  lastLogin  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  transactions Transaction[]
  basoReports  BasoReport[]

  @@index([role])
  @@index([status])
  @@map("users")
}

// -------------------------------------------------------------
// 2. STRUKTUR FASILITAS GUDANG (Kompleks Pergudangan Bulog)
// -------------------------------------------------------------
model Warehouse {
  id               String   @id @default("wh-ciskid")
  code             String   @unique @default("GBB-CISKID") @db.VarChar(50)
  name             String   @default("Kompleks Pergudangan Cisaranten Kidul (CISKID)") @db.VarChar(150)
  singkatan        String   @default("CISKID") @db.VarChar(50)
  kanwil           String   @default("Kanwil Jawa Barat") @db.VarChar(100)
  kancab           String   @default("Kantor Cabang Bandung") @db.VarChar(100)
  address          String   @db.Text // Alamat lengkap resmi
  street           String   @default("Jl. Cisaranten Kidul No. 12") @db.VarChar(150)
  kelurahan        String   @default("Cisaranten Kidul") @db.VarChar(100)
  kecamatan        String   @default("Gedebage") @db.VarChar(100)
  city             String   @default("Kota Bandung") @db.VarChar(100)
  province         String   @default("Jawa Barat") @db.VarChar(100)
  postalCode       String   @default("40292") @db.VarChar(10)
  latitude         Float?   // Koordinat Geografis (-6.9538)
  longitude        Float?   // Koordinat Geografis (107.6974)
  kepalaGudang     String   @db.VarChar(150)
  nipKepalaGudang  String   @db.VarChar(50)
  totalCapacityTon Float    @default(3000)
  activeGudang     String   @default("Gudang 1") @db.VarChar(50)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  units       WarehouseUnit[]
  stapels     Stapel[]
  basoReports BasoReport[]

  @@map("warehouses")
}

model WarehouseUnit {
  id             String    @id // e.g. "G1", "G2", "G3", "G4", "G5"
  warehouseId    String
  name           String    @db.VarChar(50) // "Gudang 1"
  layoutType     String    @default("vertical") @db.VarChar(20) // "vertical" (4x3) atau "horizontal" (3x4)
  capacityTonase Float     @default(600)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stapels        Stapel[]

  @@map("warehouse_units")
}

// -------------------------------------------------------------
// 3. TATA LETAK TUMPUKAN (2D DENAH MATRIKS STAPEL 4x3)
// -------------------------------------------------------------
enum StapelStatus {
  kosong
  sebagian
  penuh
  nonaktif
}

model Stapel {
  id           String        @id // e.g. "G1-A1", "G1-A2"
  warehouseId  String        @default("wh-ciskid")
  unitId       String        @default("G1") // Relasi ke WarehouseUnit
  gudang       String        @db.VarChar(50) // "Gudang 1"
  block        String        @db.VarChar(5)  // "A", "B", "C"
  number       Int           // 1, 2, 3, 4
  name         String        @db.VarChar(100) // "Stapel A2"
  capacityKoli Int           @default(1000)
  status       StapelStatus  @default(kosong)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  unit         WarehouseUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  batches      Batch[]
  transactions Transaction[]
  opnameRecords OpnameRecord[]

  @@index([gudang, block])
  @@index([status])
  @@map("stapels")
}

// -------------------------------------------------------------
// 4. MASTER DATA KOMODITAS PANGAN BULOG
// -------------------------------------------------------------
model Commodity {
  id               String   @id // e.g. "beras-medium", "minyakita-jerigen"
  name             String   @db.VarChar(150)
  category         String   @db.VarChar(100) // "Beras", "Minyak Goreng", "Gula", "Tepung"
  defaultUnit      String   @default("Karung") @db.VarChar(50)
  defaultWeight    Float    @default(50) // Kg per koli
  maxShelfLifeDays Int      @default(180) // Batas simpan standar (SPHP = 180 hari)
  icon             String   @default("grain") @db.VarChar(50)
  color            String   @default("#D97706") @db.VarChar(20)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  batches          Batch[]

  @@map("commodities")
}

// -------------------------------------------------------------
// 5. FISIK BATCH & UMUR SIMPAN (Aging & Prioritas Salur)
// -------------------------------------------------------------
model Batch {
  id              String    @id @default(cuid())
  stapelId        String
  commodityId     String
  batchNo         String    @db.VarChar(50) // e.g. "Batch #09"
  brand           String    @db.VarChar(150) // e.g. "Bulog CBP 50kg"
  koli            Int
  unit            String    @default("Karung") @db.VarChar(50)
  weightPerUnitKg Float     @default(50)
  dateIn          DateTime  // Tanggal penerimaan barang (dasar hitung masa simpan)
  expiryDate      DateTime?
  origin          String    @db.VarChar(150) // Asal pasokan: "Subang, Jabar"
  suratJalan      String    @db.VarChar(100) // Nomor Surat Jalan / Delivery Order
  kondisi         String    @default("Baik") @db.VarChar(50) // "Baik", "Perlu Fumigasi", "Rusak"
  notes           String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stapel          Stapel    @relation(fields: [stapelId], references: [id], onDelete: Cascade)
  commodity       Commodity @relation(fields: [commodityId], references: [id])

  @@index([stapelId])
  @@index([commodityId])
  @@index([dateIn])
  @@map("batches")
}

// -------------------------------------------------------------
// 6. RIWAYAT MUTASI STOK (Inbound, Outbound & Audit Log)
// -------------------------------------------------------------
enum TransactionType {
  MASUK
  KELUAR
  PENYESUAIAN
}

model Transaction {
  id              String          @id @default(cuid())
  type            TransactionType
  stapelId        String
  gudang          String          @db.VarChar(50)
  commodityName   String          @db.VarChar(150)
  brand           String          @db.VarChar(150)
  koli            Int
  unit            String          @db.VarChar(50)
  weightPerUnitKg Float
  totalKg         Float
  operator        String          @db.VarChar(150)
  userId          String?
  suratJalan      String          @db.VarChar(100)
  sourceOrDest    String          @db.VarChar(200) // Pemasok atau Tujuan Distribusi
  timestamp       DateTime        @default(now())
  isOffline       Boolean         @default(false)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())

  stapel          Stapel          @relation(fields: [stapelId], references: [id])
  user            User?           @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([stapelId])
  @@index([timestamp])
  @@map("transactions")
}

// -------------------------------------------------------------
// 7. DOKUMEN RESMI BERITA ACARA STOCK OPNAME (BASO)
// -------------------------------------------------------------
model BasoReport {
  id           String    @id @default(cuid())
  reportNumber String    @unique @db.VarChar(100) // e.g. "BA-SO/CISKID/2026/XI/001"
  warehouseId  String
  periodDate   DateTime  @default(now())
  totalTonase  Float
  totalKoli    Int
  stapelCount  Int
  accuracyRate Float     @default(100.0) // Persentase akurasi fisik vs sistem
  signedBy     String    @db.VarChar(150) // Nama Kepala Gudang
  signerNip    String    @db.VarChar(50)
  createdById  String?
  pdfUrl       String?   @db.VarChar(255)
  createdAt    DateTime  @default(now())

  warehouse    Warehouse @relation(fields: [warehouseId], references: [id])
  createdBy    User?     @relation(fields: [createdById], references: [id])

  @@map("baso_reports")
}

// -------------------------------------------------------------
// 8. LOG AUDIT KEAMANAN & HISTORI PERUBAHAN (GRC BUMN BULOG)
// -------------------------------------------------------------
model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  userId    String?
  user      String   @db.VarChar(150)
  role      String   @default("operator") @db.VarChar(50)
  nip       String   @default("-") @db.VarChar(50)
  action    String   @db.VarChar(100) // COMMODITY_CREATE, COMMODITY_UPDATE, BATCH_ADJUSTMENT, dll
  target    String   @db.VarChar(200)
  details   String   @db.Text
  ipAddress String?  @default("127.0.0.1") @db.VarChar(100)
  createdAt DateTime @default(now())

  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// 9. HASIL PENGHITUNGAN FISIK STOCK OPNAME (SESI BERJALAN)
// -------------------------------------------------------------
model OpnameRecord {
  id             String   @id @default(cuid())
  stapelId       String
  gudang         String   @db.VarChar(50)
  block          String   @db.VarChar(5)
  number         Int
  bookKoli       Int
  physicalKoli   Int
  variance       Int
  varianceStatus String   @db.VarChar(50) // "match", "shortage", "surplus"
  layerCount     Int      @default(0)
  perLayerKoli   Int      @default(0)
  peakKoli       Int      @default(0)
  damagedKoli    Int      @default(0)
  note           String?  @db.Text
  verifiedAt     DateTime @default(now())
  verifiedBy     String   @db.VarChar(150)
  verifiedNip    String   @db.VarChar(50)
  createdAt      DateTime @default(now())

  stapel         Stapel   @relation(fields: [stapelId], references: [id], onDelete: Cascade)

  @@index([stapelId])
  @@map("opname_records")
}
